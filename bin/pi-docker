#!/usr/bin/env bash
set -euo pipefail

SCRIPT=$(readlink -f -- "${BASH_SOURCE[0]}")
REPO=$(cd -- "$(dirname -- "$SCRIPT")/.." && pwd -P)
# shellcheck source=lib/session-lifecycle.sh
source "$REPO/lib/session-lifecycle.sh"
WORKDIR=$(pwd -P)
UID_VALUE=$(id -u)
HASH=$(printf '%s' "$WORKDIR" | sha256sum | cut -c1-16)
REPO_HASH=$(printf '%s' "$REPO" | sha256sum | cut -c1-8)
PROJECT="pi-r${REPO_HASH}-u${UID_VALUE}-${HASH}"

# All projects in this checkout share one image, but other checkouts cannot
# overwrite it. Always derive the tag here for build, start and recreate alike.
export PI_DOCKER_IMAGE="pi-docker:r${REPO_HASH}"
export PI_WORKSPACE="$WORKDIR"
export PUID="$UID_VALUE"
PGID=$(id -g)
PI_GROUPS=$(id -G | tr ' ' ',')
export PGID PI_GROUPS
export PI_SESSION_DIR="/home/node/.pi/agent/project-sessions/${UID_VALUE}-${HASH}"

# Maintenance commands do not depend on optional publishing settings.
CORE=(docker compose --project-directory "$REPO" \
    --file "$REPO/compose.yaml" --env-file "$REPO/.env.example")
CURRENT=("${CORE[@]}" --project-name "$PROJECT")

usage() {
    printf '%s\n' '用法：pi [shell [Bash 参数...]|root-shell [Bash 参数...]|stop|down [--all]|ps|build [构建参数...]|rebuild [构建参数...]|recreate]'
}

init_lifecycle() {
    session_lifecycle_init "$REPO/.runtime/$PROJECT"
}

# Only recognize this checkout, user and project-name scheme.
managed_projects() {
    local ids id name
    ids=$(docker ps -aq \
        --filter "label=com.docker.compose.project.working_dir=$REPO" \
        --filter "label=com.docker.compose.service=pi") || return
    while IFS= read -r id; do
        [[ -n "$id" ]] || continue
        name=$(docker inspect --format '{{ index .Config.Labels "com.docker.compose.project" }}' "$id") || return
        [[ "$name" =~ ^pi-r${REPO_HASH}-u${UID_VALUE}-[0-9a-f]{16}$ ]] || continue
        printf '%s\n' "$name"
    done <<< "$ids"
}

case "${1:-}" in
    --help|-h)
        usage
        exit 0
        ;;
    ps)
        shift
        if (( $# )); then usage >&2; exit 2; fi
        projects=$(managed_projects | sort -u)
        if [[ -z "$projects" ]]; then
            printf '没有此安装目录创建的项目容器。\n'
        else
            while IFS= read -r name; do
                "${CORE[@]}" --project-name "$name" ps -a
            done <<< "$projects"
        fi
        exit 0
        ;;
    down)
        shift
        if (( $# == 0 )); then
            init_lifecycle
            session_require_idle "${CURRENT[@]}" down --remove-orphans
        elif (( $# == 1 )) && [[ "$1" == --all || "$1" == -a ]]; then
            projects=$(managed_projects | sort -u)
            status=0
            if [[ -z "$projects" ]]; then
                printf '没有需要清理的项目容器。\n'
            else
                while IFS= read -r name; do
                    printf '清理 Compose 项目：%s\n' "$name"
                    session_lifecycle_init "$REPO/.runtime/$name"
                    session_require_idle "${CORE[@]}" --project-name "$name" down --remove-orphans || status=1
                done <<< "$projects"
            fi
            exit "$status"
        else
            usage >&2
            exit 2
        fi
        exit 0
        ;;
    stop)
        shift
        if (( $# )); then usage >&2; exit 2; fi
        init_lifecycle
        session_require_idle "${CURRENT[@]}" stop pi
        exit 0
        ;;
    build|rebuild)
        command=$1
        shift
        build_flags=()
        if [[ "$command" == rebuild ]]; then build_flags+=(--no-cache); fi
        "${CURRENT[@]}" build "${build_flags[@]}" "$@" pi
        exit 0
        ;;
    recreate)
        if (( $# != 1 )); then usage >&2; exit 2; fi
        ;;
    "")
        if (( $# )); then usage >&2; exit 2; fi
        ;;
    shell|root-shell) ;;
    *)
        printf '未知命令：%s\n' "$1" >&2
        usage >&2
        exit 2
        ;;
esac

if [[ "$WORKDIR" == / ]]; then
    printf '拒绝将宿主机根目录 / 挂载为工作区；请先进入具体项目目录\n' >&2
    exit 2
fi

ENV_FILE="$REPO/.env"
if [[ ! -f "$ENV_FILE" ]]; then ENV_FILE="$REPO/.env.example"; fi
COMPOSE=(docker compose --project-directory "$REPO" --project-name "$PROJECT" \
    --file "$REPO/compose.yaml" --env-file "$ENV_FILE")

# Let Compose parse dotenv once, instead of maintaining a second, incompatible parser.
# The resolved values are then validated and exported for all subsequent commands.
CONFIG_ENV=$("${COMPOSE[@]}" config --environment)
read_config_value() {
    local line
    while IFS= read -r line; do
        if [[ "$line" == "$1="* ]]; then printf '%s' "${line#*=}"; return; fi
    done <<< "$CONFIG_ENV"
}
VIBE_DIR=$(read_config_value VIBE_PROJECTS_HOST_DIR)
VIBE_URL=$(read_config_value VIBE_PUBLIC_URL)

if [[ -n "$VIBE_DIR" || -n "$VIBE_URL" ]]; then
    if [[ -z "$VIBE_DIR" || -z "$VIBE_URL" ]]; then
        printf '请同时设置 VIBE_PROJECTS_HOST_DIR 和 VIBE_PUBLIC_URL\n' >&2
        exit 1
    fi
    if [[ "$VIBE_DIR" != /* || ! -d "$VIBE_DIR" || ! -w "$VIBE_DIR" ]]; then
        printf '发布目录必须是已存在、可写的绝对路径：%s\n' "$VIBE_DIR" >&2
        exit 1
    fi
    VIBE_DIR=$(realpath -e -- "$VIBE_DIR")
    if [[ "$VIBE_DIR" == / || "$VIBE_DIR" == "$WORKDIR" || "$VIBE_DIR" == "$WORKDIR/"* || "$WORKDIR" == "$VIBE_DIR/"* ||
          "$VIBE_DIR" == "$REPO" || "$REPO" == "$VIBE_DIR/"* || "$VIBE_DIR" == "$REPO/data" || "$VIBE_DIR" == "$REPO/data/"* ]]; then
        printf '发布目录不能覆盖工作目录、工具仓库或 Pi 配置数据\n' >&2
        exit 1
    fi
    export VIBE_PROJECTS_HOST_DIR="$VIBE_DIR"
    export VIBE_PUBLIC_URL="$VIBE_URL"
    COMPOSE+=(--file "$REPO/compose.vibe.yaml")
fi

mkdir -p -- "$REPO/data"
init_lifecycle
EXEC_TTY=()
if [[ ! -t 0 || ! -t 1 ]]; then EXEC_TTY=(-T); fi

compose_start() {
    "${COMPOSE[@]}" up -d --no-recreate pi >&2
}

# Also preserve externally opened docker exec sessions. Leases protect wrapper
# sessions during the up -> exec gap; ExecIDs only supplements that guarantee.
compose_stop_if_idle() {
    local cid exec_count
    cid=$("${COMPOSE[@]}" ps -q pi 2>/dev/null) || return 0
    [[ -n "$cid" ]] || return 0
    exec_count=$(docker inspect --format '{{len .ExecIDs}}' "$cid" 2>/dev/null) || return 0
    if [[ "$exec_count" == 0 ]]; then "${COMPOSE[@]}" stop pi >&2 || true; fi
}

finish_session() {
    local status=$?
    trap - EXIT
    session_finish compose_stop_if_idle
    exit "$status"
}

case "${1:-}" in
    recreate)
        session_require_idle "${COMPOSE[@]}" up -d --force-recreate --no-build pi
        ;;
    *)
        trap finish_session EXIT
        session_start compose_start
        case "${1:-}" in
            shell)
                shift
                "${COMPOSE[@]}" exec "${EXEC_TTY[@]}" --workdir /workspace pi \
                    /usr/local/bin/pi-entrypoint --pi-docker-shell "$@"
                ;;
            root-shell)
                shift
                "${COMPOSE[@]}" exec "${EXEC_TTY[@]}" --env HOME=/root --workdir /workspace pi bash "$@"
                ;;
            "")
                "${COMPOSE[@]}" exec "${EXEC_TTY[@]}" --workdir /workspace pi /usr/local/bin/pi-entrypoint
                ;;
        esac
        ;;
esac

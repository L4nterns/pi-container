#!/usr/bin/env bash
set -euo pipefail

SCRIPT=$(readlink -f -- "${BASH_SOURCE[0]}")
REPO=$(cd -- "$(dirname -- "$SCRIPT")/.." && pwd -P)
WORKDIR=$(pwd -P)
UID_VALUE=$(id -u)
HASH=$(printf '%s' "$WORKDIR" | sha256sum | cut -c1-16)
PROJECT="pi-u${UID_VALUE}-${HASH}"

export PI_WORKSPACE="$WORKDIR"
export PUID="$UID_VALUE"
export PGID="$(id -g)"
export PI_GROUPS="$(id -G | tr ' ' ',')"
export PI_SESSION_DIR="/home/node/.pi/agent/project-sessions/${UID_VALUE}-${HASH}"

# 维护命令不依赖可选的发布配置，因此即使 .env 被删除也能清理容器。
CORE=(docker compose --project-directory "$REPO" \
    --file "$REPO/compose.yaml" --env-file "$REPO/.env.example")
CURRENT=("${CORE[@]}" --project-name "$PROJECT")

# 只识别此安装目录创建、且项目名符合 pi-docker 规则的 Compose 容器。
managed_projects() {
    local ids id name
    ids=$(docker ps -aq \
        --filter "label=com.docker.compose.project.working_dir=$REPO" \
        --filter "label=com.docker.compose.service=pi") || return
    while IFS= read -r id; do
        [[ -n "$id" ]] || continue
        name=$(docker inspect --format '{{ index .Config.Labels "com.docker.compose.project" }}' "$id") || return
        [[ "$name" =~ ^pi-u[0-9]+-[0-9a-f]{16}$ ]] || continue
        printf '%s\n' "$name"
    done <<< "$ids"
}

case "${1:-}" in
    ps)
        shift
        if (( $# )); then printf '用法：pi-docker ps\n' >&2; exit 2; fi
        projects=$(managed_projects | sort -u)
        if [[ -z "$projects" ]]; then
            printf '没有此安装目录创建的项目容器。\n'
        else
            while IFS= read -r name; do
                "${CORE[@]}" --project-name "$name" ps -a
            done <<< "$projects"
        fi
        exit 0
        ;;
    down)
        shift
        if (( $# == 0 )); then
            "${CURRENT[@]}" down --remove-orphans
        elif (( $# == 1 )) && [[ "$1" == --all || "$1" == -a ]]; then
            projects=$(managed_projects | sort -u)
            if [[ -z "$projects" ]]; then
                printf '没有需要清理的项目容器。\n'
            else
                while IFS= read -r name; do
                    printf '清理 Compose 项目：%s\n' "$name"
                    "${CORE[@]}" --project-name "$name" down --remove-orphans
                done <<< "$projects"
            fi
        else
            printf '用法：pi-docker down [-a|--all]\n' >&2
            exit 2
        fi
        exit 0
        ;;
    stop)
        shift
        if (( $# )); then printf '用法：pi-docker stop\n' >&2; exit 2; fi
        "${CURRENT[@]}" stop pi
        exit 0
        ;;
    build)
        shift
        "${CURRENT[@]}" build pi "$@"
        exit $?
        ;;
    rebuild)
        shift
        "${CURRENT[@]}" build --no-cache pi "$@"
        exit $?
        ;;
esac

if [[ "$WORKDIR" == / ]]; then
    printf '拒绝将宿主机根目录 / 挂载为工作区；请先进入具体项目目录\n' >&2
    exit 2
fi

ENV_FILE="$REPO/.env"
if [[ ! -f "$ENV_FILE" ]]; then
    ENV_FILE="$REPO/.env.example"
fi

# 从工具仓库读取发布配置，而不是从当前项目的 .env 中读取。
read_env_value() {
    local key="$1" result
    result=$(sed -n -E "s/^${key}=[[:space:]]*//p" "$ENV_FILE" | tail -n 1)
    result=${result%$'\r'}
    result=${result%\"}; result=${result#\"}
    result=${result%\'}; result=${result#\'}
    printf '%s' "$result"
}

VIBE_DIR="${VIBE_PROJECTS_HOST_DIR:-$(read_env_value VIBE_PROJECTS_HOST_DIR)}"
VIBE_URL="${VIBE_PUBLIC_URL:-$(read_env_value VIBE_PUBLIC_URL)}"
COMPOSE=(docker compose --project-directory "$REPO" --project-name "$PROJECT" \
    --file "$REPO/compose.yaml" --env-file "$ENV_FILE")

if [[ -n "$VIBE_DIR" || -n "$VIBE_URL" ]]; then
    if [[ -z "$VIBE_DIR" || -z "$VIBE_URL" ]]; then
        printf '请同时设置 VIBE_PROJECTS_HOST_DIR 和 VIBE_PUBLIC_URL\n' >&2
        exit 1
    fi
    if [[ "$VIBE_DIR" != /* ]]; then
        printf '发布目录必须使用绝对路径：%s\n' "$VIBE_DIR" >&2
        exit 1
    fi
    if [[ ! -d "$VIBE_DIR" ]]; then
        printf '发布目录不存在：%s\n' "$VIBE_DIR" >&2
        exit 1
    fi
    VIBE_DIR=$(realpath -e -- "$VIBE_DIR")
    if [[ "$VIBE_DIR" == "$WORKDIR" || "$VIBE_DIR" == "$WORKDIR/"* || "$WORKDIR" == "$VIBE_DIR/"* ]]; then
        printf '发布目录不能与当前工作目录重叠\n' >&2
        exit 1
    fi
    export VIBE_PROJECTS_HOST_DIR="$VIBE_DIR"
    export VIBE_PUBLIC_URL="$VIBE_URL"
    COMPOSE+=(--file "$REPO/compose.vibe.yaml")
fi

mkdir -p -- "$REPO/data"
EXEC_TTY=()
if [[ ! -t 0 || ! -t 1 ]]; then EXEC_TTY=(-T); fi

# 退出最后一个交互会话后停止容器，不删除容器的可写层。
# 同一项目有其他活动的 docker exec 会话时不停止，避免打断其他终端。
stop_if_idle() {
    local cid exec_count
    cid=$("${COMPOSE[@]}" ps -q pi 2>/dev/null) || return 0
    [[ -n "$cid" ]] || return 0
    exec_count=$(docker inspect --format '{{len .ExecIDs}}' "$cid" 2>/dev/null) || return 0
    if [[ "$exec_count" == 0 ]]; then
        "${COMPOSE[@]}" stop pi >&2 || true
    fi
}

# EXIT 钩子同时覆盖 /quit、正常退出与 pi 命令失败；保留 Pi 原始退出码。
finish_session() {
    local status=$?
    trap - EXIT
    stop_if_idle
    exit "$status"
}

case "${1:-}" in
    shell)
        shift
        "${COMPOSE[@]}" up -d --no-recreate pi >&2
        trap finish_session EXIT
        "${COMPOSE[@]}" exec "${EXEC_TTY[@]}" --workdir /workspace pi \
            /usr/local/bin/pi-entrypoint --pi-docker-shell "$@"
        ;;
    root-shell)
        shift
        "${COMPOSE[@]}" up -d --no-recreate pi >&2
        trap finish_session EXIT
        "${COMPOSE[@]}" exec "${EXEC_TTY[@]}" --env HOME=/root --workdir /workspace pi bash "$@"
        ;;
    recreate)
        shift
        if (( $# )); then printf '用法：pi-docker recreate\n' >&2; exit 2; fi
        "${COMPOSE[@]}" up -d --force-recreate --no-build pi
        ;;
    *)
        "${COMPOSE[@]}" up -d --no-recreate pi >&2
        trap finish_session EXIT
        "${COMPOSE[@]}" exec "${EXEC_TTY[@]}" --workdir /workspace pi \
            /usr/local/bin/pi-entrypoint "$@"
        ;;
esac

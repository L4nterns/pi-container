#!/usr/bin/env bash
# pc and pi-container share this menu; the dispatcher is not a public CLI.
set -euo pipefail
SCRIPT=$(readlink -f -- "${BASH_SOURCE[0]}")
REPO=$(cd -- "$(dirname -- "$SCRIPT")/.." && pwd -P)
help_text() {
    printf '%s\n' 'Pi in Container' '用法：pc 或 pi-container' \
        '  接回 Pi：连接原进程，任务继续。' \
        '  启动 Pi：在容器内托管，断开终端后继续运行。' \
        '  结束 Pi：停止进程，不删除对话历史。' \
        '  开发容器默认管理当前项目，另有查看全部与清理空闲；服务容器管理应用部署。' \
        '  检查更新：更新版本并重建全部镜像和容器；中断前询问，保留持久数据。' \
        '  安装／卸载随实际状态切换；删除容器和镜像，保留挂载的会话、应用及部署脚本。' \
        '  镜像构建与容器重建由安装／检查更新统一完成，不需要手动构建。' \
        '  对话、历史、模型和插件由原生 Pi 管理。' \
        '「Esc」返回／退出 · 「↑/↓」选择 · 「Enter」确认；危险操作默认取消。' \
        '断开：「Ctrl+B」，再按「D」；结束：在菜单选择「结束 Pi」。'
}
if (( $# )); then
    if (( $# == 1 )) && [[ "$1" == --help || "$1" == -h ]]; then help_text; exit 0; fi
    printf '请只输入「pc」或「pi-container」，在菜单中选择。\n' >&2; exit 2
fi
if [[ ! -t 0 || ! -t 1 ]]; then printf 'pc / pi-container 需要交互终端；请直接在终端运行。\n' >&2; exit 2; fi
# shellcheck source=lib/menu.sh
source "$REPO/lib/menu.sh"
CONTROL="$REPO/scripts/control.sh"
declare -A positions=()
MENU_NOTICE=''
SAVED_TTY=$(stty -g)
trap 'stty "$SAVED_TTY"; menu_screen_close' EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
menu_screen_open
# Positions belong to this invocation, never to user/project configuration.
choose() {
    local key=$1; shift
    choice=$(MENU_INDEX="${positions[$key]:-0}" menu_select "$@") || return
    positions[$key]=$choice
    MENU_NOTICE=''
}
confirm() {
    local selected
    selected=$(MENU_INDEX=0 MENU_NOTICE="$1" menu_select '确认操作' '取消' '确认') || return 1
    [[ "$selected" == 1 ]]
}
message() (
    local file
    file=$(umask 077; mktemp) || return
    trap 'rm -f -- "$file"' EXIT
    printf '%s\n' "$2" > "$file"
    menu_view "$1" "$file"
)
# One output screen for status/logs/builds and errors. Private transient capture
# enables paging; it is removed on return/signals. No hidden worker or operation
# is left behind when Esc returns after completion.
command_output() (
    local mode=$1 title=$2 file status=0 saved
    shift 2
    file=$(umask 077; mktemp) || return
    saved=$(stty -g)
    trap 'stty "$saved"; rm -f -- "$file"' EXIT
    stty -echo
    menu_heading "$title" '「正在执行」' || return
    if bash "$CONTROL" "$@" </dev/null 2>&1 | tail -c 1048576 > "$file"; then :
    else status=$?; fi
    if [[ "$mode" == view ]] || (( status )); then
        local result=''
        (( status == 0 )) || result="「操作失败」退出码：$status · "
        MENU_RESULT=$result MENU_VIEW_END=1 menu_view "$title" "$file"
    fi
    return "$status"
)
run() {
    local mode=$1 title=$2; shift 2
    if command_output "$mode" "$title" "$@"; then
        if [[ "$mode" == change ]]; then MENU_NOTICE="「已完成」$title"; fi
    fi
}
# Once a real terminal is handed over, this menu invocation is finished.
# exec also leaves all dispatcher diagnostics visible on the primary screen.
terminal() {
    shift
    stty "$SAVED_TTY"
    menu_screen_close
    trap - EXIT
    exec bash "$CONTROL" "$@"
}
query_rows() (
    local title=$1 failure=$2 file status=0; shift 2
    file=$(umask 077; mktemp) || return
    trap 'rm -f -- "$file"' EXIT
    menu_heading "$title" '「正在读取」' || return
    rows=$(bash "$CONTROL" "$@" 2>"$file") || status=$?
    if (( status )); then
        [[ -s "$file" ]] || printf '%s\n' "$failure" > "$file"
        MENU_RESULT="「查询失败」退出码：$status · " menu_view "$title" "$file"; return 1
    fi
    printf '%s' "$rows"
)
pick_running() {
    local rows name attached created choice invalid=0
    local -a names=() labels=()
    rows=$(query_rows '运行中的 Pi' '「查询失败」请稍后重试。' pi-running) || return 1
    if [[ -z "$rows" ]]; then message '运行中的 Pi' '「暂无运行中的 Pi」可返回选择「启动 Pi」；历史对话使用「/resume」。'; return 1; fi
    while IFS=$'\t' read -r name attached created; do
        if [[ ! "$name" =~ ^[a-zA-Z0-9][a-zA-Z0-9_-]{0,47}$ || ! "$attached" =~ ^[0-9]+$ || ! "$created" =~ ^[0-9]+$ ]]; then invalid=1; break; fi
        names+=("$name")
        if [[ "$attached" == 0 ]]; then labels+=("$name"$'\t后台运行'); else labels+=("$name"$'\t'"$attached 个终端连接"); fi
    done <<< "$rows"
    if (( invalid )); then message '运行中的 Pi' '「进程状态格式错误」请稍后重试。'; return 1; fi
    choice=$(MENU_INDEX=0 menu_select '运行中的 Pi' "${labels[@]}") || return 1
    printf '%s' "${names[choice]}"
}
install_menu() {
    local state=$1 activity
    while true; do
        if [[ "$state" != install && "$state" != uninstall ]]; then
            if ! state=$(query_rows '安装状态' '无法读取 Docker 状态。' tool-install-state); then
                if confirm '状态读取失败，是否重新检查？'; then continue; fi
                return 0
            fi
        fi
        if [[ "$state" == uninstall ]]; then
            activity=$(query_rows '卸载 · 会话与影响范围' '无法完整读取会话。' tool-remove-plan) || activity='无法完整读取会话；会按管理标签重新核对范围，确认后中断全部受管会话。'
            if ! MENU_CONTEXT="$activity" confirm '卸载下列范围的全部容器与镜像，会中断列出的会话；保留挂载数据和脚本'; then return 0; fi
            if command_output view '卸载' tool-uninstall; then return 0; fi
        else
            if ! confirm '安装：无缓存重建开发／服务镜像；启用部署时启动服务，保留已有数据'; then return 0; fi
            if command_output view '安装' tool-install; then return 0; fi
        fi
        if ! confirm '操作未完成，是否重新检查范围并重试此操作？'; then return 0; fi
    done
}
ensure_runtime() {
    local state
    state=$(query_rows '运行环境' '无法检查镜像。' tool-runtime-ready) || return 1
    [[ "$state" != ready ]] || return 0
    install_menu install
    [[ "$(bash "$CONTROL" tool-runtime-ready 2>/dev/null)" == ready ]]
}
app_menu() {
    local rows name enabled revision choice target invalid
    local -a names=() labels=() revisions=()
    while true; do
        names=(); labels=(); revisions=(); invalid=0
        rows=$(query_rows '应用自启动' '「读取失败」请检查服务容器。' service-app-list) || return 0
        if [[ -z "$rows" ]]; then message '应用自启动' '「暂无应用」请先发布应用。'; return 0; fi
        while IFS=$'\t' read -r name enabled revision; do
            if [[ ! "$name" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$ || ! "$enabled" =~ ^(true|false)$ || ! "$revision" =~ ^[0-9a-f]{64}$ ]]; then invalid=1; break; fi
            names+=("$name"); revisions+=("$revision")
            if [[ "$enabled" == true ]]; then labels+=("$name"$'\t已启用'); else labels+=("$name"$'\t已禁用'); fi
        done <<< "$rows"
        if (( invalid )); then message '应用自启动' '「应用状态格式错误」请重新打开。'; return 0; fi
        choice=$(MENU_INDEX=0 MENU_NOTICE='下次服务启动生效，当前进程不变' menu_select '服务容器 · 应用自启动' "${labels[@]}") || return 0
        name=${names[choice]}; revision=${revisions[choice]}
        choice=$(MENU_INDEX=0 MENU_NOTICE='下次服务启动生效，当前进程不变' menu_select "应用自启动 · $name" $'启用自启动\t随服务容器启动' $'禁用自启动\t保持手动启动') || continue
        case "$choice" in 0) target=true ;; 1) target=false ;; *) continue ;; esac
        if confirm "「$name」修改自启动？当前进程不变"; then run change '应用自启动' service-app-set "$name" "$target" "$revision"; fi
    done
}
update_menu() {
    local versions old target mode selected activity
    while true; do
        if ! versions=$(query_rows '检查更新' '「检查失败」请检查 Git 和网络连接。' tool-check); then
            if confirm '检查失败，是否重新检查？'; then continue; fi
            return 0
        fi
        IFS=$'\t' read -r old target mode <<< "$versions"
        if [[ ! "$old" =~ ^[0-9a-f]{40}([0-9a-f]{24})?$ || ! "$target" =~ ^[0-9a-f]{40}([0-9a-f]{24})?$ || ! "$mode" =~ ^(standard|backup)$ ]]; then
            message '检查更新' '版本信息不完整；请重新检查。'; return 0
        fi
        if [[ "$mode" == backup ]]; then
            selected=$(MENU_INDEX=0 MENU_NOTICE='本地修改／分支与上游不同；备份留在本地，不自动重放' menu_select '检查更新 · 本地源码' '取消' $'备份后更新\t保留本地提交和修改，切换到上游 main') || return 0
            [[ "$selected" == 1 ]] || return 0
        fi
        if ! activity=$(query_rows "检查更新 · ${old:0:8} → ${target:0:8}" '无法完整核对范围。' tool-plan); then
            if confirm '范围检查失败，是否重新检查？'; then continue; fi
            return 0
        fi
        local note='更新并重建全部受管镜像与已有容器；Pi、终端和应用会中断，请先备份'
        [[ "$old" != "$target" ]] || note='源码已是最新；仍要构建全部镜像并重建已有容器？Pi、终端和应用会中断'
        if ! MENU_CONTEXT="当前：${old:0:8} → 上游：${target:0:8}"$'\n'"$activity" confirm "$note"; then return 0; fi
        if command_output view '检查更新 · 更新与重建' tool-update "$old" "$target" "$mode"; then exit 0; fi
        if confirm '维护未完成，是否重新打开 pc 后检查并重试？'; then
            stty "$SAVED_TTY"; menu_screen_close; trap - EXIT
            exec bash "$SCRIPT"
        fi
        exit 0
    done
}
container_menu() {
    local kind=$1 title choice action selected activity
    local -a actions=(state shell logs) labels=(
        $'查看状态\t容器与运行环境' $'管理终端\t进入容器 Shell' $'查看日志\t最近 200 行'
    )
    if [[ "$kind" == service ]]; then
        title='服务容器'
        actions+=(start); labels+=($'启动容器\t等待核心服务就绪')
    else title='开发容器'; fi
    actions+=(stop remove)
    labels+=($'停止容器\t保留数据' $'删除容器\t保留数据')
    if [[ "$kind" == service ]]; then actions+=(apps); labels+=($'应用自启动\t逐个应用设置')
    else
        actions+=(list remove-all)
        labels+=($'查看全部\t本安装、当前用户的开发容器' $'清理空闲\t批量删除空闲开发容器，保留数据')
    fi
    while true; do
        choose "$kind" "$title" "${labels[@]}" || return 0
        action=${actions[choice]}
        case "$action" in
            state|logs|list) run view "$title · ${labels[choice]%%$'\t'*}" "$kind-$action" ;;
            shell) if ensure_runtime; then terminal "$title · 管理终端" "$kind-shell"; fi ;;
            start) if ensure_runtime; then run change '服务容器 · 启动容器' service-start; fi ;;
            apps) app_menu ;;
            remove-all)
                activity=$(query_rows '开发容器 · 会话与范围' '无法完整读取会话。' dev-all-activity) || activity='会话状态读取不完整，确认后仍按本安装、当前用户范围检查。'
                selected=$(MENU_INDEX=0 MENU_CONTEXT="$activity" MENU_NOTICE='中断后清理全部会结束列出的 Pi／终端；挂载数据保留' menu_select '清理开发容器' '取消' '仅清理空闲' '中断后清理全部') || continue
                if [[ "$selected" == 2 ]]; then run view '开发容器 · 清理全部' dev-remove-all --confirmed-interruption
                elif [[ "$selected" == 1 ]]; then
                    if ! command_output view '开发容器 · 清理空闲' dev-remove-all; then
                        if MENU_CONTEXT="$activity" confirm '仍有占用或未知状态，是否中断下面列出的会话后继续清理全部？'; then run view '开发容器 · 清理全部' dev-remove-all --confirmed-interruption; fi
                    fi
                fi ;;
            stop|remove)
                while true; do
                    activity=$(query_rows "$title · 会话与影响范围" '无法完整读取会话。' "$kind-activity") || activity='会话状态读取不完整；确认继续仍会中断此容器的全部会话。'
                    if ! MENU_CONTEXT="$activity" confirm "「${labels[choice]%%$'\t'*}」会中断下面容器的全部 Pi、终端或应用；保留挂载数据"; then break; fi
                    if [[ "$kind" == dev ]]; then
                        if command_output change "$title · ${labels[choice]%%$'\t'*}" "$kind-$action" --confirmed-interruption; then MENU_NOTICE="「已完成」${labels[choice]%%$'\t'*}"; break; fi
                    elif command_output change "$title · ${labels[choice]%%$'\t'*}" "$kind-$action"; then MENU_NOTICE="「已完成」${labels[choice]%%$'\t'*}"; break; fi
                    if ! confirm '操作未完成，是否重新检查会话后重试？'; then break; fi
                done ;;
        esac
    done
}
while true; do
    install_state=$(bash "$CONTROL" tool-install-state 2>/dev/null) || install_state=unknown
    case "$install_state" in
        install) install_label=$'安装\t准备镜像与运行环境' ;;
        uninstall) install_label=$'卸载\t删除镜像和容器，保留挂载数据' ;;
        *) install_label=$'安装状态\t重新检测后选择安装或卸载' ;;
    esac
    MENU_NOTICE=${MENU_NOTICE:-$(pwd -P)}
    MENU_ESCAPE_LABEL=退出 choose main 'Pi in Container' \
        $'接回 Pi\t继续原进程' $'启动 Pi\t断开终端后继续运行' \
        $'结束 Pi\t停止进程，保留历史' $'开发容器\t当前项目与批量维护' $'服务容器\t应用部署与自启动' \
        $'检查更新\t更新版本并重建全部镜像和容器' "$install_label" || exit 0
    case "$choice" in
        0) if name=$(pick_running); then terminal '接回 Pi' pi-connect "$name"; fi ;;
        1) if ensure_runtime; then terminal '启动 Pi' pi-start; fi ;;
        2) if name=$(pick_running) && confirm "「结束 $name」请求和工具将中断；保留历史"; then run change '结束 Pi' pi-end "$name"; fi ;;
        3) container_menu dev ;;
        4) container_menu service ;;
        5) update_menu ;;
        6) install_menu "$install_state" ;;
    esac
done

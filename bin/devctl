#!/usr/bin/env bash
set -euo pipefail

SCRIPT=$(readlink -f -- "${BASH_SOURCE[0]}")
REPO=$(cd -- "$(dirname -- "$SCRIPT")/.." && pwd -P)
# shellcheck source=lib/session-lifecycle.sh
source "$REPO/lib/session-lifecycle.sh"
# shellcheck source=lib/deployment.sh
source "$REPO/lib/deployment.sh"
WORKDIR=$(pwd -P)
UID_VALUE=$(id -u)
HASH=$(printf '%s' "$WORKDIR" | sha256sum | cut -c1-16)
REPO_HASH=$(printf '%s' "$REPO" | sha256sum | cut -c1-8)
PROJECT="dev-r${REPO_HASH}-u${UID_VALUE}-${HASH}"

# All projects in this checkout share one image, but other checkouts cannot
# overwrite it. Always derive the tag here for build, start and recreate alike.
export DEV_IMAGE="devctl:r${REPO_HASH}"
export DEV_WORKSPACE="$WORKDIR"
export DEV_UID="$UID_VALUE"
DEV_GID=$(id -g)
DEV_GROUPS=$(id -G | tr ' ' ',')
export DEV_GID DEV_GROUPS
export DEV_SESSION_DIR="/home/node/.pi/agent/project-sessions/${UID_VALUE}-${HASH}"

# Maintenance commands do not depend on optional publishing settings.
CORE=(docker compose --project-directory "$REPO" \
    --file "$REPO/compose.yaml" --env-file "$REPO/.env.example")
CURRENT=("${CORE[@]}" --project-name "$PROJECT")

usage() {
    printf '%s\n' \
        '用法：devctl [命令]' \
        '  devctl                         当前项目运行 Pi（开发容器）' \
        '  devctl shell [Bash 参数...]     进入开发容器 Shell' \
        '  devctl server [Bash 参数...]    进入独立服务容器 Shell（SSH）' \
        '  devctl stop | down [--all] | ps | recreate' \
        '  devctl build | rebuild [构建参数...]' \
        '  devctl services {up|stop|down|ps|logs|build|recreate}'
}

init_lifecycle() {
    session_lifecycle_init "$REPO/.runtime/$PROJECT"
}

# Only recognize this checkout, user and project-name scheme.
managed_projects() {
    local ids id name
    ids=$(docker ps -aq \
        --filter "label=com.docker.compose.project.working_dir=$REPO" \
        --filter "label=com.docker.compose.service=pi") || return
    while IFS= read -r id; do
        [[ -n "$id" ]] || continue
        name=$(docker inspect --format '{{ index .Config.Labels "com.docker.compose.project" }}' "$id") || return
        [[ "$name" =~ ^dev-r${REPO_HASH}-u${UID_VALUE}-[0-9a-f]{16}$ ]] || continue
        printf '%s\n' "$name"
    done <<< "$ids"
}

# All state belongs to one non-root host identity, including service locks and
# credentials. Do not create root-owned installation state via sudo devctl.
# if [[ "$UID_VALUE" == 0 && "${1:-}" != --help && "${1:-}" != -h ]]; then
#     printf '请使用非 root 宿主机用户运行 devctl，不要 sudo devctl。\n' >&2
#     exit 2
# fi

case "${1:-}" in
    --help|-h)
        usage
        exit 0
        ;;
    ps)
        shift
        if (( $# )); then usage >&2; exit 2; fi
        projects=$(managed_projects | sort -u)
        if [[ -z "$projects" ]]; then
            printf '没有此安装目录创建的项目容器。\n'
        else
            while IFS= read -r name; do
                "${CORE[@]}" --project-name "$name" ps -a
            done <<< "$projects"
        fi
        exit 0
        ;;
    down)
        shift
        if (( $# == 0 )); then
            init_lifecycle
            session_require_idle "${CURRENT[@]}" down --remove-orphans
        elif (( $# == 1 )) && [[ "$1" == --all || "$1" == -a ]]; then
            projects=$(managed_projects | sort -u)
            status=0
            if [[ -z "$projects" ]]; then
                printf '没有需要清理的项目容器。\n'
            else
                while IFS= read -r name; do
                    printf '清理 Compose 项目：%s\n' "$name"
                    session_lifecycle_init "$REPO/.runtime/$name"
                    session_require_idle "${CORE[@]}" --project-name "$name" down --remove-orphans || status=1
                done <<< "$projects"
            fi
            exit "$status"
        else
            usage >&2
            exit 2
        fi
        exit 0
        ;;
    stop)
        shift
        if (( $# )); then usage >&2; exit 2; fi
        init_lifecycle
        session_require_idle "${CURRENT[@]}" stop pi
        exit 0
        ;;
    build|rebuild)
        command=$1
        shift
        build_flags=()
        if [[ "$command" == rebuild ]]; then build_flags+=(--no-cache); fi
        "${CURRENT[@]}" build "${build_flags[@]}" "$@" pi
        exit 0
        ;;
    recreate)
        if (( $# != 1 )); then usage >&2; exit 2; fi
        ;;
    "")
        if (( $# )); then usage >&2; exit 2; fi
        ;;
    shell|server) ;;
    services)
        if (( $# != 2 )); then usage >&2; exit 2; fi
        case "$2" in
            up|stop|down|ps|logs|build|recreate) ;;
            *) usage >&2; exit 2 ;;
        esac
        ;;
    *)
        printf '未知命令：%s\n' "$1" >&2
        usage >&2
        exit 2
        ;;
esac

if [[ "$WORKDIR" == / && "${1:-}" != services && "${1:-}" != server ]]; then
    printf '拒绝将宿主机根目录 / 挂载为工作区；请先进入具体项目目录\n' >&2
    exit 2
fi

ENV_FILE="$REPO/.env"
if [[ ! -f "$ENV_FILE" ]]; then ENV_FILE="$REPO/.env.example"; fi
COMPOSE=(docker compose --project-directory "$REPO" --project-name "$PROJECT" \
    --file "$REPO/compose.yaml" --env-file "$ENV_FILE")

deployment_config
if [[ "${1:-}" == server ]]; then
    shift
    provision_deployment
    tty_flags=()
    if [[ -t 0 && -t 1 ]]; then tty_flags=(-it); else tty_flags=(-i); fi
    docker run --rm --init --pull never "${tty_flags[@]}" --security-opt no-new-privileges \
        --network "$DEPLOY_NETWORK" \
        --mount "type=bind,source=$DEPLOY_CREDENTIAL_DIR,target=/run/deploy-credentials,readonly" \
        --env "DEV_UID=$DEV_UID" --env "DEV_GID=$DEV_GID" --env "DEV_GROUPS=$DEV_GROUPS" \
        --entrypoint /usr/local/bin/dev-entrypoint "$DEV_IMAGE" --service-shell "$@"
    exit $?
fi
if [[ "${1:-}" == services ]]; then
    deployment_require_config
    exec {services_fd}>>"$REPO/.services.lock"
    flock -x "$services_fd"
    case "$2" in
        up) "${SERVICE_COMPOSE[@]}" up -d --wait --no-recreate services ;;
        stop) "${SERVICE_COMPOSE[@]}" stop services ;;
        down) "${SERVICE_COMPOSE[@]}" down --remove-orphans ;;
        ps) "${SERVICE_COMPOSE[@]}" ps ;;
        logs) "${SERVICE_COMPOSE[@]}" logs --tail 200 services ;;
        build) "${SERVICE_COMPOSE[@]}" build services ;;
        recreate) "${SERVICE_COMPOSE[@]}" up -d --wait --force-recreate --no-build services ;;
        *) usage >&2; exit 2 ;;
    esac
    exit 0
fi
deployment_require_workspace
if [[ -n "$DEPLOY_DATA_DIR" ]]; then
    provision_deployment
fi

mkdir -p -- "$REPO/data"
init_lifecycle
EXEC_TTY=()
if [[ ! -t 0 || ! -t 1 ]]; then EXEC_TTY=(-T); fi

compose_start() {
    "${COMPOSE[@]}" up -d --no-recreate pi >&2
}

# Also preserve externally opened docker exec sessions. Leases protect wrapper
# sessions during the up -> exec gap; ExecIDs only supplements that guarantee.
compose_stop_if_idle() {
    local cid exec_count
    cid=$("${COMPOSE[@]}" ps -q pi 2>/dev/null) || return 0
    [[ -n "$cid" ]] || return 0
    exec_count=$(docker inspect --format '{{len .ExecIDs}}' "$cid" 2>/dev/null) || return 0
    if [[ "$exec_count" == 0 ]]; then "${COMPOSE[@]}" stop pi >&2 || true; fi
}

finish_session() {
    local status=$?
    trap - EXIT
    session_finish compose_stop_if_idle
    exit "$status"
}

case "${1:-}" in
    recreate)
        session_require_idle "${COMPOSE[@]}" up -d --force-recreate --no-build pi
        ;;
    *)
        trap finish_session EXIT
        session_start compose_start
        case "${1:-}" in
            shell)
                shift
                "${COMPOSE[@]}" exec "${EXEC_TTY[@]}" --workdir /workspace pi \
                    /usr/local/bin/dev-entrypoint --dev-shell "$@"
                ;;
            "")
                "${COMPOSE[@]}" exec "${EXEC_TTY[@]}" --workdir /workspace pi /usr/local/bin/dev-entrypoint
                ;;
        esac
        ;;
esac
